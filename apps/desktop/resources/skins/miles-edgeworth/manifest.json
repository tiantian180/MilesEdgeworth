        "action": "drag_crouch",
        "holdCompleted": true
      },
      "action": "drag_stand_up_full"
    },
    {
      "event": "pointer.dragReleased",
      "when": {
        "action": "drag_crouch",
        "holdCompleted": false
      },
      "action": "drag_stand_up_quick"
    }
  ],
