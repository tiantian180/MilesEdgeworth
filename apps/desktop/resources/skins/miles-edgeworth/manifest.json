      "action": "idle_stand"
    },
    "thinking": {
      "action": "thinking"
    },
    "speaking": {
      "action": "objecting"
    }
  },
  "actions": {
    "idle_stand": {
      "label": "站立",
      "category": "idle",
      "loopMode": "loop",
      "priority": 0,
      "tags": ["idle", "standing"],
      "variants": {
        "right": {
          "animation": "qrc:/pet/stand-right.gif"
        },
        "left": {
          "animation": "qrc:/pet/stand-left.gif"
        }
      }
    },
    "thinking": {
      "label": "抱胸思考",
      "category": "cognitive",
      "loopMode": "loop",
      "priority": 20,
      "tags": ["thinking", "cognitive"],
      "variants": {
        "right": {
          "animation": "qrc:/pet/thinking-right.gif"
        },
        "left": {
          "animation": "qrc:/pet/thinking-left.gif"
        }
      }
    },
    "objecting": {
      "label": "异议",
      "category": "gesture",
      "loopMode": "onceThenIdle",
      "priority": 40,
      "tags": ["objecting", "speaking", "emphasis"],
      "variants": {
        "right": {
          "animation": "qrc:/pet/objecting-right.gif"
        },
        "left": {
          "animation": "qrc:/pet/objecting-left.gif"
        }
      }
    },
    "bow": {
      "label": "鞠躬",
      "category": "gesture",
      "loopMode": "onceThenIdle",
      "priority": 30,
      "tags": ["bow", "polite"],
      "variants": {
        "right": {
          "animation": "qrc:/pet/bow-right.gif"
        },
        "left": {
          "animation": "qrc:/pet/bow-left.gif"
        }
      }
